# ==============================================================================
# INTERVIEW-MEET CONTEXT ENGINE — GATE 1 POC ENVIRONMENT VARIABLES
# Copy file này thành `.env` tại thư mục gốc dự án và điền ít nhất 1 trong 2 key:
#   cp .env.example .env
# ==============================================================================

# 1. Groq API Key (Free Tier tại https://console.groq.com/keys)
# Dùng cho model `whisper-large-v3-turbo` (~$0.04/giờ hoặc $0.02/giờ Batch)
GROQ_API_KEY=

# 2. Soniox API Key (Lấy tại https://console.soniox.com)
# Dùng cho model `stt-async-v4` hỗ trợ Structured Context & Code-Switching Anh-Việt (~$0.10/giờ)
SONIOX_API_KEY=
SONIOX_MODEL=stt-async-v4

# 3. Gemini API Key (Chuẩn bị sẵn cho Cổng 2 - Post-Call Debrief trên Google AI Studio)
GEMINI_API_KEY=
